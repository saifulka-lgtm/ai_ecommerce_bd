# ---- Database ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_ecommerce_bd

# ---- AI Provider ----
# One of: mock | claude | ollama
AI_PROVIDER=mock

# Only needed if AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Only needed if AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Security ----
SECRET_KEY=change-this-to-a-random-string-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Better: leave ADMIN_PASSWORD out and set a hash made with:
#   python -m app.utils.hash_password
# ADMIN_PASSWORD_HASH=

# ---- Abuse protection (per IP, per minute) ----
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- App ----
# With ENVIRONMENT=production the app REFUSES to start on default secrets.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI fulfillment agent (auto PENDING -> CONFIRMED -> SHIPPED -> DELIVERED) ----
AUTO_FULFILLMENT_ENABLED=true
FULFILLMENT_POLL_SECONDS=10
FULFILLMENT_CONFIRM_AFTER_SECONDS=30
FULFILLMENT_SHIP_AFTER_SECONDS=90
FULFILLMENT_DELIVER_AFTER_SECONDS=180
